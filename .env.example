# Telegram (from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-bot-token

# Comma-separated Telegram user IDs of staff (from @userinfobot)
ALLOWED_TELEGRAM_IDS=111111111,222222222,333333333

# true = test without Google Sheets (in-memory; lost on restart)
MOCK_MODE=true

# --- Required when MOCK_MODE=false ---
# Google Spreadsheet ID (from the sheet URL)
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
# GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# Paste the full service-account JSON as a single line, OR use a file:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Optional: worksheet name (default: Sheet1)
# GOOGLE_SHEET_NAME=Sheet1
